# RaiCentral Community Edition — environment template
# Powered by Ztechnium. One organization. Copy to .env for local development.
# Never commit real secrets.
# For a server, start from .env.production.example instead.

# --- Required (development defaults shown) ---
DATABASE_URL=postgresql://rai_user:rai_password@localhost:5434/rai_gateway
REDIS_URL=redis://localhost:6380
# Required by Docker Compose. PostgreSQL applies it only when its volume is first
# created. This is a development value: keep it equal to the one in DATABASE_URL.
POSTGRES_PASSWORD=rai_password
# Compose publishes ports on 127.0.0.1. Set 0.0.0.0 only on a trusted network.
# POSTGRES_BIND_ADDRESS=127.0.0.1
# REDIS_BIND_ADDRESS=127.0.0.1
# GATEWAY_BIND_ADDRESS=127.0.0.1
# UI_BIND_ADDRESS=127.0.0.1

# --- Optional feature flags ---
ENABLE_CACHE=true
ENABLE_CASES=true
ENABLE_RAG=false
ENABLE_XAI=true
ENABLE_ETHICS_EVAL=true

# --- Security (development-only defaults — change for any shared environment) ---
JWT_SECRET_KEY=dev-only-change-me
REQUIRE_API_KEY=true
# Legacy shared admin token (X-Admin-Token) for local scripts. Empty disables it.
ADMIN_TOKEN=
REQUIRE_STEP_UP=true
STEP_UP_TOKEN=
ALLOW_SHARED_SECRET_STEP_UP=false
# Development only: creates this operator on first use. Production keeps it false
# and runs `rai-gateway admin create`.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@raigateway.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
# Sample systems on this one instance. Leave false for an empty first install.
ENABLE_REFERENCE_PILOT_SEED=false
EVIDENCE_ENCRYPTION_KEY=dev-only-encryption-key

# --- LLM providers (optional — not required for default test suite) ---
LLM_PROVIDER=openai
LLM_PROVIDER_MODEL=gpt-3.5-turbo
# LLM_PROVIDER_API_KEY=

# --- Observability (optional) ---
LOG_LEVEL=INFO
# OTEL_ENDPOINT=http://localhost:4317

# --- Build metadata (set in CI) ---
# GIT_COMMIT_SHA=
# BUILD_TIME=
# SCHEMA_REVISION=

# --- Frontend (control-plane-ui) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
# Unused by the console. Anything NEXT_PUBLIC_* is readable by every browser.
NEXT_PUBLIC_ADMIN_TOKEN=

# --- RAI management MCP (Streamable HTTP + OAuth) ---
MCP_SERVER_ENABLED=true
# Public URL clients use for the API (include a reverse proxy prefix such as /api).
# Compose derives it from NEXT_PUBLIC_API_BASE_URL.
# API_PUBLIC_BASE_URL=
# Only when MCP clients must use a different URL. HTTPS unless loopback.
# MCP_SERVER_PUBLIC_BASE_URL=
MCP_SERVER_MOUNT_PATH=/mcp
MCP_OAUTH_ENABLE_DCR=true
MCP_OAUTH_SCOPES=rai:read,rai:manage

# --- Sign-in and email links (this instance only; no public signup) ---
APP_PUBLIC_URL=http://localhost:3000
AUTH_ACCESS_TOKEN_MINUTES=480
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_SET_COOKIES=false

# --- Transactional email (Resend SMTP). Leave EMAIL_ENABLED=false for local/dev. ---
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=RaiCentral
# EMAIL_FROM_ADDRESS=no-reply@your-verified-domain.com
# EMAIL_REPLY_TO=support@your-domain.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
# SMTP_PASSWORD=<RESEND_API_KEY>
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
# EMAIL_DOCS_URL=https://docs.example.com

# --- Onboarding intake (Step 02) ---
# Private directory for original source files. API and worker must share it.
ONBOARDING_SOURCE_STORAGE_ROOT=./data/onboarding-sources
ONBOARDING_MAX_FILE_BYTES=26214400
ONBOARDING_MAX_SOURCES_PER_SESSION=20
ONBOARDING_MAX_SESSION_BYTES=209715200
ONBOARDING_MAX_TEXT_CHARS=50000
ONBOARDING_UPLOAD_TIMEOUT_SECONDS=600
# Must exceed the upload timeout.
ONBOARDING_ORPHAN_MIN_AGE_SECONDS=86400
ONBOARDING_JOB_LEASE_SECONDS=60
ONBOARDING_JOB_RENEW_SECONDS=15
ONBOARDING_JOB_MAX_ATTEMPTS=5

# --- Onboarding extraction (Step 03) ---
# Parser limits are part of the extraction identity; API and worker must use identical values.
ONBOARDING_PARSER_WALL_SECONDS=120
ONBOARDING_PARSER_MEMORY_BYTES=536870912
ONBOARDING_PDF_MAX_PAGES=300
ONBOARDING_OOXML_MAX_ENTRIES=10000
ONBOARDING_OOXML_MAX_TOTAL_BYTES=104857600
ONBOARDING_OOXML_MAX_MEMBER_BYTES=26214400
ONBOARDING_OOXML_MAX_RATIO=100
ONBOARDING_XLSX_MAX_SHEETS=50
ONBOARDING_TABULAR_MAX_ROWS=10000
ONBOARDING_TABULAR_MAX_COLUMNS=200
ONBOARDING_MAX_CELLS_VISITED=200000
ONBOARDING_MAX_NONEMPTY_CELLS=50000
ONBOARDING_EXTRACT_OUTPUT_BYTES_PER_SOURCE=16777216
ONBOARDING_EXTRACT_OUTPUT_BYTES_PER_RUN=67108864

# --- Unified internal AI (ONE config for content evaluation, AI onboarding, ...) ---
# Environment only: nothing here is stored in the database or editable in the UI.
# provider: openai | anthropic | gemini | vertex | openai_compatible
RAI_AI_PROVIDER=
RAI_AI_MODEL=
# Extra models allowed besides RAI_AI_MODEL (comma separated, optional).
# RAI_AI_MODELS=
# Credential:
#   openai / anthropic / gemini : RAI_AI_API_KEY (required)
#   vertex, option A (API key)  : RAI_AI_API_KEY = a Google Cloud API key (Vertex express mode)
#   vertex, option B (service account, used when RAI_AI_API_KEY is empty):
#       RAI_AI_GCP_SERVICE_ACCOUNT_JSON = single-line key JSON, else the gateway's own
#       GCP_SERVICE_ACCOUNT_JSON / GOOGLE_APPLICATION_CREDENTIALS / GKE metadata server.
#       Needs roles/aiplatform.user and a project: RAI_AI_GCP_PROJECT_ID or GCP_PROJECT_ID.
RAI_AI_API_KEY=
# RAI_AI_GCP_SERVICE_ACCOUNT_JSON=
# RAI_AI_GCP_PROJECT_ID=      # default: GCP_PROJECT_ID
# RAI_AI_LOCATION=global      # default: GCP_LOCATION (Gemini 3.x models are global-only)
# openai_compatible only (vLLM, LiteLLM, OpenRouter, Ollama...). AI onboarding needs https.
# RAI_AI_BASE_URL=https://llm.example.com/v1
# RAI_AI_ALLOW_PRIVATE_NETWORK=false
# RAI_AI_TIMEOUT_SECONDS=30
# RAI_AI_TEMPERATURE=0.0
# RAI_AI_MAX_OUTPUT_TOKENS=8192   # also the cap for inventory analysis replies
# JSON_SCHEMA | JSON_OBJECT | JSON_PROMPT (defaults: openai JSON_SCHEMA, anthropic
# JSON_PROMPT, others JSON_OBJECT)
# RAI_AI_STRUCTURED_MODE=
# Precedence: CONTENT_EVALUATOR_* still overrides the evaluator when set; with
# CONTENT_EVALUATOR_PROVIDER unset the evaluator uses RAI_AI_*. When RAI_AI_PROVIDER is set,
# AI onboarding uses it exclusively and ONBOARDING_AI_TARGETS_JSON is ignored.

# --- Onboarding AI configuration (Step 03) ---
# Deployment-approved targets (JSON list). There is no default provider or model. Example:
# ONBOARDING_AI_TARGETS_JSON=[{"key":"primary","label":"Primary model","protocol":"OPENAI_COMPATIBLE_CHAT","base_url":"https://llm.example.com/v1","models":["model-a"],"structured_modes":["JSON_SCHEMA","JSON_OBJECT"],"token_param":"max_tokens","max_output_tokens":1024,"credential_alias":"PRIMARY","credential_version":1,"timeout_seconds":30}]
ONBOARDING_AI_TARGETS_JSON=
# Credential for alias PRIMARY (onboarding-only; never LLM_PROVIDER_API_KEY). Bump
# credential_version in the target when you rotate it.
# ONBOARDING_AI_KEY_PRIMARY=
