# RaiCentral behind Nginx: console and API on one origin.
#
#   https://rai.example.com       -> console   (127.0.0.1:3000)
#   https://rai.example.com/api/  -> API       (127.0.0.1:8001), "/api" stripped
#
# Match in .env:
#   APP_PUBLIC_URL=https://rai.example.com
#   CORS_ALLOWED_ORIGINS=https://rai.example.com
#   NEXT_PUBLIC_API_BASE_URL=https://rai.example.com/api
#
# For a separate API domain, give it its own server block whose only location is
# `location / { proxy_pass http://127.0.0.1:8001; }` with the same headers, and set
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com.

server {
    listen 80;
    server_name rai.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name rai.example.com;

    ssl_certificate     /etc/letsencrypt/live/rai.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rai.example.com/privkey.pem;

    # Onboarding uploads are up to 25 MB (ONBOARDING_MAX_FILE_BYTES).
    client_max_body_size 30m;

    # Inherited by every location below. X-Forwarded-For is overwritten, not
    # appended, so a client cannot choose the address the API records.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /api/ {
        proxy_pass http://127.0.0.1:8001/;
        # Streaming model responses and MCP server-sent events.
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    # MCP OAuth discovery (RFC 9728 / RFC 8414) lives at the origin root. Without
    # these two locations MCP clients cannot find how to sign in.
    location /.well-known/oauth-protected-resource {
        proxy_pass http://127.0.0.1:8001;
    }

    location /.well-known/oauth-authorization-server {
        proxy_pass http://127.0.0.1:8001;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
    }
}
