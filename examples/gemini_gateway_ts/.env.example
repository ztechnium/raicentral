# RAI gateway base (no trailing slash). The example appends /providers/vertex-ai
RAI_BASE_URL=http://localhost:8001
# RaiCentral runtime credential. NOT a Google credential; the gateway holds those.
RAI_RUNTIME_CREDENTIAL=
GEMINI_MODEL=gemini-3.1-flash-lite
# Project and location your app sends; the gateway keeps the project pinned.
GCP_PROJECT_ID=
GCP_LOCATION=global
